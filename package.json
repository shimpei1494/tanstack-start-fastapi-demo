{
  "name": "tanstack-start-fastapi-demo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @demo/web",
    "build": "npm run build --workspace @demo/web",
    "start": "npm run start --workspace @demo/web",
    "lint": "oxlint --type-aware --type-check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "npm --prefix tooling/api-codegen run generate",
    "check": "npm run lint && npm run format:check && npm test && npm run build && npm run check:boundary",
    "setup:codegen": "npm --prefix tooling/api-codegen ci --workspaces=false",
    "verify:typecheck": "node scripts/verify-typecheck.mjs",
    "check:boundary": "node scripts/check-client-boundary.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}

# Build from repository root with -f infra/runtime/Dockerfile.api.
FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.2 /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN mkdir -p /opt/rds && python -c "import urllib.request; urllib.request.urlretrieve('https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem', '/opt/rds/global-bundle.pem')"
COPY services/api/pyproject.toml services/api/uv.lock ./
RUN uv sync --frozen --no-dev --extra aws --no-install-project
COPY services/api/src ./src
COPY services/api/alembic ./alembic
COPY services/api/alembic.ini ./
RUN uv sync --frozen --no-dev --extra aws
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
CMD ["python", "-m", "demo_api.aws_runtime", "serve"]

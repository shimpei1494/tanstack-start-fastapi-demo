{
  "components": {
    "schemas": {
      "DemoMessage": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "content"
        ],
        "title": "DemoMessage",
        "type": "object"
      },
      "DemoRunAgentInput": {
        "additionalProperties": false,
        "description": "The supported text-only subset of AG-UI's SDK input, on both boundaries.",
        "properties": {
          "context": {
            "items": {},
            "maxItems": 0,
            "title": "Context",
            "type": "array"
          },
          "forwardedProps": {
            "$ref": "#/components/schemas/ForwardedProps"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/DemoMessage"
            },
            "maxItems": 40,
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "parentRunId": {
            "title": "Parentrunid",
            "type": "null"
          },
          "protocolVersion": {
            "anyOf": [
              {
                "const": "1.0",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocolversion"
          },
          "resume": {
            "title": "Resume",
            "type": "null"
          },
          "runId": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Runid",
            "type": "string"
          },
          "state": {
            "additionalProperties": true,
            "maxProperties": 0,
            "title": "State",
            "type": "object"
          },
          "threadId": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Threadid",
            "type": "string"
          },
          "tools": {
            "items": {},
            "maxItems": 0,
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "threadId",
          "runId",
          "state",
          "messages",
          "tools",
          "context",
          "forwardedProps"
        ],
        "title": "DemoRunAgentInput",
        "type": "object"
      },
      "ForwardedProps": {
        "additionalProperties": false,
        "properties": {
          "scenario": {
            "default": "normal",
            "enum": [
              "normal",
              "slow",
              "error",
              "disconnect",
              "before-error"
            ],
            "title": "Scenario",
            "type": "string"
          }
        },
        "title": "ForwardedProps",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Suggestion": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "Suggestion",
        "type": "object"
      },
      "SuggestionRequest": {
        "additionalProperties": false,
        "properties": {
          "goal": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "scenario": {
            "default": "normal",
            "enum": [
              "normal",
              "slow",
              "error"
            ],
            "title": "Scenario",
            "type": "string"
          }
        },
        "required": [
          "goal"
        ],
        "title": "SuggestionRequest",
        "type": "object"
      },
      "SuggestionResponse": {
        "additionalProperties": false,
        "properties": {
          "model_version": {
            "const": "mock-v1",
            "default": "mock-v1",
            "title": "Model Version",
            "type": "string"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "suggestions"
        ],
        "title": "SuggestionResponse",
        "type": "object"
      },
      "TodoCreate": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "TodoCreate",
        "type": "object"
      },
      "TodoRead": {
        "properties": {
          "completed": {
            "title": "Completed",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "completed",
          "created_at",
          "updated_at"
        ],
        "title": "TodoRead",
        "type": "object"
      },
      "TodoUpdate": {
        "additionalProperties": false,
        "properties": {
          "completed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "TodoUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Local single-user demo. Deterministic AI; no external models.",
    "title": "TanStack Start demo API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ai/suggestions": {
      "post": {
        "operationId": "suggestTodos",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuggestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Suggestions"
      }
    },
    "/chat/stream": {
      "post": {
        "operationId": "streamChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoRunAgentInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat"
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/todos": {
      "get": {
        "operationId": "listTodos",
        "parameters": [
          {
            "in": "query",
            "name": "completed",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Completed"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TodoRead"
                  },
                  "title": "Response Listtodos",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Todos"
      },
      "post": {
        "operationId": "createTodo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Todo"
      }
    },
    "/todos/{todo_id}": {
      "delete": {
        "operationId": "deleteTodo",
        "parameters": [
          {
            "in": "path",
            "name": "todo_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Todo Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Todo"
      },
      "patch": {
        "operationId": "updateTodo",
        "parameters": [
          {
            "in": "path",
            "name": "todo_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Todo Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Todo"
      }
    }
  }
}
